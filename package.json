{
  "name": "flixify-app-pro",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @flixify/contracts && npm run build -w @flixify/sdk && npm run build -w @flixify/viewer-core && npm run build -w @flixify/api && npm run build -w @flixify/worker",
    "build:ops": "npm run build -w @flixify/ops-web",
    "check:env": "node scripts/preflight.mjs",
    "dev": "node scripts/preflight.mjs && node scripts/dev-stack.mjs",
    "dev:api": "npm run dev -w @flixify/api",
    "dev:ops": "npm run dev -w @flixify/ops-web",
    "dev:worker": "npm run dev -w @flixify/worker",
    "configure:native-qt": "npm run configure -w @flixify/viewer-native-qt",
    "build:native-qt": "npm run build -w @flixify/viewer-native-qt",
    "smoke:p0": "node scripts/smoke-p0.mjs",
    "telegram:panel": "node scripts/telegram-panel-bot.mjs",
    "telegram:vscode": "node scripts/telegram-vscode.mjs",
    "quality:p0": "npm run test && npm run build && npm run smoke:p0",
    "supabase:run-sql": "node scripts/run-supabase-sql.mjs",
    "test": "npm run test -w @flixify/contracts && npm run test -w @flixify/api && npm run test -w @flixify/worker"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "node-telegram-bot-api": "^0.67.0"
  },
  "version": "2.1.0"
}
