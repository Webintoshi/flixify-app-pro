{
  "name": "@flixify/viewer-native-qt",
  "version": "2.3.39",
  "private": true,
  "type": "module",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "run": "node scripts/run.mjs",
    "bundle:windows": "node scripts/package.mjs --preset windows-x64-release",
    "bundle:macos": "node scripts/package.mjs --preset macos-universal-release",
    "bundle:android": "node scripts/package.mjs --preset android-arm64-release",
    "bundle:android-tv": "node scripts/package.mjs --preset android-tv-arm64-release",
    "bundle:android-tv-emulator": "node scripts/package.mjs --preset android-tv-x86_64-release",
    "bundle:android-tv-32bit": "node scripts/package.mjs --preset android-tv-armv7-release"
  }
}
