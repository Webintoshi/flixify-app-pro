{
  "name": "@flixify/viewer-native-qt",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "build": "node scripts/build.mjs",
    "run": "node scripts/run.mjs",
    "bundle:windows": "node scripts/build.mjs --preset windows-x64-release",
    "bundle:macos": "node scripts/build.mjs --preset macos-universal-release",
    "bundle:android": "node scripts/build.mjs --preset android-arm64-release",
    "bundle:android-tv": "node scripts/build.mjs --preset android-tv-arm64-release"
  }
}
