{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "LIBVLC_ROOT": {
          "type": "PATH",
          "value": "$env{LIBVLC_ROOT}"
        },
        "FLIXIFY_API_BASE_URL": {
          "type": "STRING",
          "value": "$env{FLIXIFY_API_BASE_URL}"
        }
      },
      "environment": {
        "CMAKE_PREFIX_PATH": "$penv{CMAKE_PREFIX_PATH};$env{QT_ROOT}"
      }
    },
    {
      "name": "windows-x64-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-x64-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-universal-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      }
    },
    {
      "name": "android-arm64-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "Android",
        "CMAKE_ANDROID_ARCH_ABI": "arm64-v8a",
        "ANDROID_ABI": "arm64-v8a",
        "QT_ANDROID_ABIS": "arm64-v8a",
        "Qt6_DIR": {
          "type": "PATH",
          "value": "$env{QT_ROOT}/lib/cmake/Qt6"
        }
      },
      "environment": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
      }
    },
    {
      "name": "android-x86_64-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "Android",
        "CMAKE_ANDROID_ARCH_ABI": "x86_64",
        "ANDROID_ABI": "x86_64",
        "QT_ANDROID_ABIS": "x86_64",
        "Qt6_DIR": {
          "type": "PATH",
          "value": "$env{QT_ROOT}/lib/cmake/Qt6"
        }
      },
      "environment": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
      }
    },
    {
      "name": "android-armv7-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "Android",
        "CMAKE_ANDROID_ARCH_ABI": "armeabi-v7a",
        "ANDROID_ABI": "armeabi-v7a",
        "QT_ANDROID_ABIS": "armeabi-v7a",
        "Qt6_DIR": {
          "type": "PATH",
          "value": "$env{QT_ROOT}/lib/cmake/Qt6"
        }
      },
      "environment": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}"
      }
    },
    {
      "name": "android-tv-arm64-release",
      "inherits": "android-arm64-release",
      "cacheVariables": {
        "FLIXIFY_ANDROID_TV": "ON"
      }
    },
    {
      "name": "android-tv-x86_64-release",
      "inherits": "android-x86_64-release",
      "cacheVariables": {
        "FLIXIFY_ANDROID_TV": "ON"
      }
    },
    {
      "name": "android-tv-armv7-release",
      "inherits": "android-armv7-release",
      "cacheVariables": {
        "FLIXIFY_ANDROID_TV": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release"
    },
    {
      "name": "macos-universal-release",
      "configurePreset": "macos-universal-release"
    },
    {
      "name": "android-arm64-release",
      "configurePreset": "android-arm64-release"
    },
    {
      "name": "android-x86_64-release",
      "configurePreset": "android-x86_64-release"
    },
    {
      "name": "android-armv7-release",
      "configurePreset": "android-armv7-release"
    },
    {
      "name": "android-tv-arm64-release",
      "configurePreset": "android-tv-arm64-release"
    },
    {
      "name": "android-tv-x86_64-release",
      "configurePreset": "android-tv-x86_64-release"
    },
    {
      "name": "android-tv-armv7-release",
      "configurePreset": "android-tv-armv7-release"
    }
  ]
}
