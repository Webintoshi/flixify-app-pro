# Copy values into Coolify Environment variables.
# Production rule: do not use localhost values.

DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-<region>.pooler.supabase.com:5432/postgres
APP_JWT_SECRET=replace-with-64-char-random-secret
APP_DEMO_MODE=false
ADMIN_EMAILS=admin@yourdomain.com

API_PORT=4000
OPS_WEB_PORT=3000
VIEWER_WEBOS_PORT=4173
FFMPEG_BINARY=ffmpeg
APP_UPDATE_MANIFEST_URL=https://app.flixify.pro/app-update-manifest.json

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

PUBLIC_API_BASE_URL=https://api.flixify.pro
PUBLIC_SUPPORT_WHATSAPP=https://wa.me/900000000000
PUBLIC_SUPPORT_TELEGRAM=https://t.me/yourchannel

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_API_BASE_URL=https://api.flixify.pro
NEXT_PUBLIC_APP_DEMO_MODE=false
NEXT_PUBLIC_SUPPORT_WHATSAPP=https://wa.me/900000000000
NEXT_PUBLIC_SUPPORT_TELEGRAM=https://t.me/yourchannel

VITE_API_BASE_URL=https://api.flixify.pro
VITE_APP_DEMO_MODE=false
